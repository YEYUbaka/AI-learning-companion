# ============================================
# 智学伴 AI个性化学习平台 - 环境变量模板
# 复制此文件为 .env，并填入真实配置
# ============================================

# ============================================
# 数据库配置（必填，仅支持 MySQL）
# ============================================
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/zhixueban?charset=utf8mb4

# ============================================
# 安全配置（生产环境必须修改！）
# ============================================
# JWT 签名密钥（建议使用 openssl rand -hex 32 生成）
SECRET_KEY=your-secret-key-change-in-production-please-use-strong-random-key

# API 密钥加密密钥（用于加密存储数据库中的 AI API 密钥）
ENCRYPTION_KEY=your-32-character-encryption-key-here

# ============================================
# AI 模型配置
# ============================================
# 默认提供商（deepseek / siliconflow / wenxin / xinghuo / chatglm / moonshot）
DEFAULT_AI_PROVIDER=deepseek

# 请求超时时间（秒）
AI_TIMEOUT=120

# ============================================
# DeepSeek 配置（官方接口：https://api.deepseek.com）
# 获取 Key：https://platform.deepseek.com/api_keys
# ============================================
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ============================================
# 硅基流动 配置（OpenAI 兼容接口，可调用 DeepSeek/Qwen/Llama 等）
# 官网：https://cloud.siliconflow.cn  Base URL：https://api.siliconflow.cn/v1
# 获取 Key：https://cloud.siliconflow.cn/account/ak
# ============================================
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# ============================================
# 文心一言 配置
# ============================================
WENXIN_API_KEY=your_wenxin_api_key_here

# ============================================
# 星火 配置
# ============================================
XINGHUO_API_KEY=your_xinghuo_api_key_here

# ============================================
# ChatGLM 配置
# ============================================
CHATGLM_API_KEY=your_chatglm_api_key_here

# ============================================
# Moonshot 配置
# ============================================
MOONSHOT_API_KEY=your_moonshot_api_key_here

# ============================================
# 种子数据同步配置
# ============================================
AUTO_SYNC_SEED_DATA=true
PROMPT_SEED_PATH=seed_data/prompts.json
MODEL_CONFIG_SEED_PATH=seed_data/models.json

# ============================================
# 知识库路径配置（RAG 可选功能）
# ============================================
KNOWLEDGE_BASE_DIR=knowledge_base
CHROMA_DB_DIR=knowledge_base/_index

# HuggingFace 国内镜像（RAG 模型下载加速）
HF_ENDPOINT=https://hf-mirror.com

# ============================================
# Vite 前端开发服务器配置
# ============================================
# 允许的域名（逗号分隔，用于外网访问开发服务器）
# 示例：VITE_ALLOWED_HOSTS=example.com,subdomain.example.com
# VITE_ALLOWED_HOSTS=your-domain.com

# ============================================
# 日志配置
# ============================================
LOG_LEVEL=INFO
