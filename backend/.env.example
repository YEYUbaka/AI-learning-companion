# ============================================
# 智学伴后端环境变量模板
# 复制本文件为 .env 后再按实际环境填写
# ============================================

# 数据库
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/zhixueban?charset=utf8mb4

# 安全
SECRET_KEY=your-secret-key-change-in-production-please-use-strong-random-key
ENCRYPTION_KEY=your-32-character-encryption-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# AI
DEFAULT_AI_PROVIDER=deepseek
AI_TIMEOUT=120
DEEPSEEK_API_KEY=your_deepseek_api_key_here
WENXIN_API_KEY=your_wenxin_api_key_here
XINGHUO_API_KEY=your_xinghuo_api_key_here
CHATGLM_API_KEY=your_chatglm_api_key_here
MOONSHOT_API_KEY=your_moonshot_api_key_here

# 种子数据
AUTO_SYNC_SEED_DATA=true
PROMPT_SEED_PATH=seed_data/prompts.json
MODEL_CONFIG_SEED_PATH=seed_data/models.json

# RAG
KNOWLEDGE_BASE_DIR=knowledge_base
CHROMA_DB_DIR=knowledge_base/_index
HF_ENDPOINT=https://hf-mirror.com

# 日志
LOG_LEVEL=INFO

# 前端开发服务器
# VITE_ALLOWED_HOSTS=example.com,subdomain.example.com

# 运维
# 全量重置脚本可读取该变量；不要把真实值提交到 Git
# BULK_RESET_DEFAULT_PASSWORD=YourStrongPass!9
