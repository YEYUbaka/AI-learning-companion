@startuml 智学伴平台 - UML部署图
!theme plain
skinparam backgroundColor #FAFAFA
skinparam nodeFontSize 13
skinparam nodeFontStyle bold
skinparam nodeBackgroundColor #E8F0FE
skinparam nodeBorderColor #2563EB
skinparam componentBackgroundColor #FFFFFF
skinparam componentBorderColor #64748B
skinparam arrowColor #334155
skinparam arrowFontSize 11
skinparam databaseBackgroundColor #FEF3C7
skinparam databaseBorderColor #D97706
skinparam artifactBackgroundColor #F0FDF4
skinparam artifactBorderColor #16A34A
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #CBD5E1
skinparam titleFontSize 16

title 智学伴 AI 个性化学习平台 - UML 部署图

' ===== 用户终端 =====
node "用户终端" as ClientNode <<Device>> {
    component "Web 浏览器" as Browser
}

' ===== 生产服务器（云服务器 47.111.227.9）=====
node "云服务器\n(阿里云 ECS)\n47.111.227.9" as ProdServer <<Server>> {

    package "Nginx 反向代理\n(Port: 80 / 443)" as NginxPkg {
        component "Nginx" as Nginx {
            artifact "前端静态文件\nfrontend/dist" as FrontendDist
        }
    }

    package "后端运行时\n(Port: 8000)" as BackendPkg {
        component "Uvicorn ASGI 服务器" as Uvicorn {
            component "FastAPI 应用\n(main.py)" as FastAPI

            package "路由层 (routers/)" as Routers {
                component "auth\n认证路由" as RouterAuth
                component "quiz\n组卷路由" as RouterQuiz
                component "learning_map\n知识图谱路由" as RouterLM
                component "agent\nAgent路由" as RouterAgent
                component "knowledge\nRAG知识库路由" as RouterKnowledge
            }

            package "业务层 (services/)" as Services {
                component "AIService\nAI调用统一接口" as AIService
                component "AgentExecutor\nAgent执行引擎" as AgentExecutor
                component "QuizService\n智能组卷" as QuizService
                component "LearningMapService\n知识图谱" as LMService
                component "RAGService\n语义检索" as RAGService
                component "PromptService\nPrompt管理" as PromptService
                component "BootstrapService\n种子数据同步" as Bootstrap
            }

            package "核心层 (core/)" as Core {
                component "Security\nJWT认证/密钥加密" as Security
                component "Config\n环境变量管理" as Config
                component "Logger\n统一日志" as Logger
            }

            package "工具层 (utils/)" as Utils {
                component "ModelRegistry\n模型注册与降级" as ModelRegistry
                component "FileParser\n文档解析" as FileParser
                component "AgentTools\n工具集合" as AgentTools
            }
        }
    }

    package "数据存储层" as StorageLayer {
        database "MySQL 8.x\n(Port: 3306)\nzhixueban" as MySQL {
            artifact "users 用户表" as TUsers
            artifact "prompts Prompt模板表" as TPrompts
            artifact "model_config 模型配置表" as TModelConfig
            artifact "quiz 题库/答卷表" as TQuiz
            artifact "study_plan 学习计划表" as TStudyPlan
            artifact "api_call_log 调用日志表" as TApiLog
        }

        database "ChromaDB\n向量数据库\nknowledge_base/_index" as ChromaDB {
            artifact "KnowledgeChunk\n知识块向量索引" as VectorIndex
        }

        artifact "知识库文件\nknowledge_base/corpus/\n(.md 文档)" as KnowledgeFiles
    }
}

' ===== 外部 AI 服务 =====
cloud "外部 AI API 服务\n(HTTPS/443)" as ExternalAI {
    component "DeepSeek API\n(默认Provider)" as DeepSeekAPI
    component "智谱AI / 通义千问\n讯飞星火 / Moonshot\n百度千帆 / OpenRouter\n(Fallback降级链)" as OtherAI
}

' ===== 开发环境（本地）=====
node "开发者本地机\n(Windows)" as DevMachine <<Device>> {
    package "本地开发服务" as LocalDev {
        component "Vite 开发服务器\n(Port: 5173)" as ViteDev
        component "Uvicorn 热重载\n(Port: 8000)" as LocalUvicorn
        database "MySQL (本地)\n(Port: 3306)" as LocalMySQL
    }
    artifact "源代码仓库\nE:/AI_projects/Web" as SourceCode
}

' ===== 连接关系 =====

' 用户到生产服务器
Browser -right-> Nginx : HTTP/HTTPS\n(Port 80/443)

' Nginx 路由分发
Nginx -down-> FrontendDist : 静态文件\n(GET /)
Nginx -right-> FastAPI : 反向代理\n(GET/POST /api/*\nWS /ws/*)

' 前端到后端（开发环境）
Browser ..> ViteDev : HTTP\n(Port 5173)\n[开发环境]

' 路由层到业务层
FastAPI --> Routers
RouterAuth --> Security
RouterAgent --> AgentExecutor
RouterQuiz --> QuizService
RouterLM --> LMService
RouterKnowledge --> RAGService

' 业务层内部依赖
AgentExecutor --> AIService
AgentExecutor --> AgentTools
AgentTools --> RAGService
AgentTools --> LMService
AgentTools --> QuizService
QuizService --> AIService
LMService --> AIService
AIService --> PromptService
AIService --> ModelRegistry

' 业务层到数据库
AIService --> MySQL : SQLAlchemy ORM\n读写模型配置/Prompt
QuizService --> MySQL : 读写题库
LMService --> MySQL : 读写知识图谱
AgentExecutor --> MySQL : 写入调用日志
RAGService --> ChromaDB : 语义向量检索
RAGService --> KnowledgeFiles : 读取 Markdown 源文件

' 外部AI调用
ModelRegistry --> DeepSeekAPI : HTTPS API调用\n(OpenAI兼容格式)
ModelRegistry --> OtherAI : HTTPS API调用\n(Fallback降级)

' 文件解析工具
AgentTools --> FileParser : 解析上传文档

' 开发到生产同步
SourceCode ..> ProdServer : scp 上传\n+ systemctl restart

' 本地环境连接
ViteDev ..> LocalUvicorn : HTTP代理\n/api/*
LocalUvicorn ..> LocalMySQL

@enduml
